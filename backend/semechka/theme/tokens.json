{
  "schema": "semechka.theme-tokens/1",
  "note": "Canonical design tokens. The web client imports this file at build time and the server validates themes against it. Each token is a CSS custom property --<id>. Presets are the three maintained themes; Custom is built from Colour 1, Colour 2 and Accent, with every token overridable.",
  "groups": [
    {"id": "brand", "label": "Brand"},
    {"id": "surfaces", "label": "Backgrounds"},
    {"id": "text", "label": "Text"},
    {"id": "lines", "label": "Borders and states"},
    {"id": "controls", "label": "Buttons and links"},
    {"id": "status", "label": "Status"}
  ],
  "tokens": [
    {"id": "brand", "group": "brand", "label": "Colour 1 — primary brand", "hint": "Identity colour: primary buttons, the selected-item marker and the logo area. Changing it re-derives buttons and selection.", "alpha": false},
    {"id": "brand-2", "group": "brand", "label": "Colour 2 — secondary brand", "hint": "Supporting colour: your messages, secondary highlights and backgrounds tint toward it.", "alpha": false},
    {"id": "accent", "group": "brand", "label": "Accent", "hint": "Links, focus rings and small highlights. Must stay readable on every background.", "alpha": false},
    {"id": "bg", "group": "surfaces", "label": "Primary background", "alpha": false},
    {"id": "bg-2", "group": "surfaces", "label": "Secondary background", "hint": "Table headers, code blocks, quiet panels.", "alpha": false},
    {"id": "sidebar-bg", "group": "surfaces", "label": "Sidebar background", "alpha": true},
    {"id": "header-bg", "group": "surfaces", "label": "Header background", "alpha": true},
    {"id": "composer-bg", "group": "surfaces", "label": "Composer background", "alpha": true},
    {"id": "user-msg-bg", "group": "surfaces", "label": "Your messages", "alpha": true},
    {"id": "assistant-msg-bg", "group": "surfaces", "label": "Assistant messages", "hint": "The same as the background gives replies no bubble, which is easiest to read.", "alpha": true},
    {"id": "card-bg", "group": "surfaces", "label": "Cards and menus", "alpha": false},
    {"id": "fg", "group": "text", "label": "Primary text", "alpha": false},
    {"id": "fg-2", "group": "text", "label": "Secondary text", "alpha": false},
    {"id": "fg-muted", "group": "text", "label": "Muted text", "alpha": false},
    {"id": "border", "group": "lines", "label": "Borders", "alpha": true},
    {"id": "border-strong", "group": "lines", "label": "Control borders", "hint": "Outlines of inputs and buttons; needs 3:1 against the background.", "alpha": false},
    {"id": "hover", "group": "lines", "label": "Hover", "alpha": true},
    {"id": "selected", "group": "lines", "label": "Selected", "alpha": true},
    {"id": "btn-bg", "group": "controls", "label": "Button", "alpha": false},
    {"id": "btn-fg", "group": "controls", "label": "Button text", "alpha": false},
    {"id": "btn-primary-bg", "group": "controls", "label": "Primary button", "alpha": false},
    {"id": "btn-primary-fg", "group": "controls", "label": "Primary button text", "alpha": false},
    {"id": "link", "group": "controls", "label": "Links", "alpha": false},
    {"id": "success", "group": "status", "label": "Success", "alpha": false},
    {"id": "warn", "group": "status", "label": "Warning", "alpha": false},
    {"id": "danger", "group": "status", "label": "Error", "alpha": false},
    {"id": "info", "group": "status", "label": "Information", "alpha": false}
  ],
  "contrast": [
    {"fg": "fg", "bg": "bg", "min": 4.5, "label": "Primary text on background"},
    {"fg": "fg", "bg": "card-bg", "min": 4.5, "label": "Primary text on cards"},
    {"fg": "fg", "bg": "sidebar-bg", "min": 4.5, "label": "Text in the sidebar"},
    {"fg": "fg", "bg": "header-bg", "min": 4.5, "label": "Text in the header"},
    {"fg": "fg", "bg": "composer-bg", "min": 4.5, "label": "Text in the composer"},
    {"fg": "fg", "bg": "user-msg-bg", "min": 4.5, "label": "Text in your messages"},
    {"fg": "fg", "bg": "assistant-msg-bg", "min": 4.5, "label": "Text in assistant messages"},
    {"fg": "fg", "bg": "selected", "min": 4.5, "label": "Text on a selected item"},
    {"fg": "fg", "bg": "hover", "min": 4.5, "label": "Text on a hovered item"},
    {"fg": "fg-2", "bg": "bg", "min": 4.5, "label": "Secondary text on background"},
    {"fg": "fg-muted", "bg": "bg", "min": 4.5, "label": "Muted text on background"},
    {"fg": "fg-muted", "bg": "card-bg", "min": 4.5, "label": "Muted text on cards"},
    {"fg": "fg-muted", "bg": "sidebar-bg", "min": 4.5, "label": "Muted text in the sidebar"},
    {"fg": "link", "bg": "bg", "min": 4.5, "label": "Links on background"},
    {"fg": "link", "bg": "card-bg", "min": 4.5, "label": "Links on cards"},
    {"fg": "accent", "bg": "bg", "min": 3.0, "label": "Focus ring and accent marks"},
    {"fg": "btn-fg", "bg": "btn-bg", "min": 4.5, "label": "Button text"},
    {"fg": "btn-primary-fg", "bg": "btn-primary-bg", "min": 4.5, "label": "Primary button text"},
    {"fg": "border-strong", "bg": "bg", "min": 3.0, "label": "Control outlines"},
    {"fg": "danger", "bg": "bg", "min": 4.5, "label": "Error text"},
    {"fg": "success", "bg": "bg", "min": 4.5, "label": "Success text"},
    {"fg": "warn", "bg": "bg", "min": 4.5, "label": "Warning text"},
    {"fg": "info", "bg": "bg", "min": 4.5, "label": "Information text"}
  ],
  "presets": {
    "light": {
      "label": "Light", "scheme": "light",
      "values": {
        "brand": "#2B2F31", "brand-2": "#0B6E69", "accent": "#0B6E69",
        "bg": "#F7F7F5", "bg-2": "#EEEFEC", "sidebar-bg": "#EFEFEC", "header-bg": "#F7F7F5", "composer-bg": "#FFFFFF",
        "user-msg-bg": "#E9EAE6", "assistant-msg-bg": "#F7F7F5", "card-bg": "#FFFFFF",
        "fg": "#1D2021", "fg-2": "#3D4345", "fg-muted": "#5C6264",
        "border": "#DCDDD9", "border-strong": "#878C89", "hover": "#E7E8E4", "selected": "#E0E6E3",
        "btn-bg": "#FFFFFF", "btn-fg": "#1D2021", "btn-primary-bg": "#2B2F31", "btn-primary-fg": "#FFFFFF",
        "link": "#0B6E69", "success": "#23744F", "warn": "#875A0F", "danger": "#BC3631", "info": "#36698A"
      }
    },
    "dark": {
      "label": "Dark", "scheme": "dark",
      "values": {
        "brand": "#ECEDEA", "brand-2": "#6CC3B9", "accent": "#6CC3B9",
        "bg": "#141617", "bg-2": "#1C1F20", "sidebar-bg": "#101213", "header-bg": "#141617", "composer-bg": "#1E2122",
        "user-msg-bg": "#262A2B", "assistant-msg-bg": "#141617", "card-bg": "#1B1E1F",
        "fg": "#ECEDEA", "fg-2": "#C5C9C6", "fg-muted": "#9EA4A2",
        "border": "#2D3132", "border-strong": "#61676A", "hover": "#222627", "selected": "#1F2D2C",
        "btn-bg": "#1E2122", "btn-fg": "#ECEDEA", "btn-primary-bg": "#ECEDEA", "btn-primary-fg": "#141617",
        "link": "#6CC3B9", "success": "#55C595", "warn": "#D9A441", "danger": "#EF6D67", "info": "#7DB3D4"
      }
    },
    "graphite": {
      "label": "Graphite", "scheme": "dark",
      "values": {
        "brand": "#E6E8E4", "brand-2": "#7CC9BF", "accent": "#7CC9BF",
        "bg": "#24282A", "bg-2": "#2B3032", "sidebar-bg": "#1F2325", "header-bg": "#24282A", "composer-bg": "#2E3335",
        "user-msg-bg": "#353B3D", "assistant-msg-bg": "#24282A", "card-bg": "#2C3133",
        "fg": "#E8EAE6", "fg-2": "#CACECB", "fg-muted": "#A9B0AD",
        "border": "#3D4345", "border-strong": "#737A7D", "hover": "#31373A", "selected": "#2F3E3D",
        "btn-bg": "#2E3335", "btn-fg": "#E8EAE6", "btn-primary-bg": "#E6E8E4", "btn-primary-fg": "#1D2123",
        "link": "#7CC9BF", "success": "#5CC99A", "warn": "#DCAA4A", "danger": "#F38E8A", "info": "#84B9D9"
      }
    }
  },
  "typography": {
    "fonts": [
      {"id": "plex", "label": "IBM Plex Sans", "stack": "'IBM Plex Sans', system-ui, -apple-system, 'Segoe UI', sans-serif"},
      {"id": "system", "label": "System interface font", "stack": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif"},
      {"id": "humanist", "label": "Humanist (system)", "stack": "Seravek, 'Gill Sans Nova', Ubuntu, Calibri, 'DejaVu Sans', source-sans-pro, sans-serif"},
      {"id": "serif", "label": "Serif (system)", "stack": "Charter, 'Bitstream Charter', 'Sitka Text', Cambria, Georgia, serif"}
    ],
    "mono": "'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace"
  }
}
