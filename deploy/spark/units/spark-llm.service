[Unit]
Description=Spark LLM - llama.cpp router (OpenAI-compatible; the single inference API)
Documentation=file://%h/spark-llm/README.md

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=%h/spark-llm/llama/llama-v0.7.0
ExecStart=%h/spark-llm/llama/llama-v0.7.0/llama-server --host 0.0.0.0 --port 8080 --models-preset %h/spark-llm/models.ini --models-max 3 --api-key-file %h/spark-llm/keys.txt --no-webui --metrics
Restart=on-failure
RestartSec=5
# unload on stop must really free memory: kill the whole cgroup (router + model children)
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target
